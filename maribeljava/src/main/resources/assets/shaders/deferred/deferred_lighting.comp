#version 430 core

layout (local_size_x = 2, local_size_y = 2) in;

layout (binding = 0, rgba16f) uniform writeonly image2D defferedSceneImage;

layout (binding = 2, rgba16f) uniform readonly image2DMS albedoSampler;
layout (binding = 3, rgba32f) uniform readonly image2DMS worldPositionSampler;
layout (binding = 4, rgba16f) uniform readonly image2DMS normalSampler;
layout (binding = 5, rgba16f) uniform readonly image2DMS specular_emission_diffuse_ssao_bloom_Sampler;
layout (binding = 7, r8) uniform readonly image2D sampleCoverageMask;

layout (std140) uniform DirectionLight {
    vec3 direction;
    float intensity;
    vec3 ambient;
    vec3 color;
} directionLight;

/*layout (std140, row_major) uniform DirectionalLightViewProjections{
	mat4 m_lightViewProjection[3];
	float splitRange[3];
} directional_light_matrices;


uniform sampler2DArray csm;
uniform uint shadowEnable;*/

uniform vec3 viewPosition;
uniform int numSamples;

// --- Lighting Functions ---
vec3 ambient(vec3 lightAmbient, float intensity) {
    return lightAmbient * intensity; // Simple ambient calculation
}

vec3 diffuse(vec3 lightColor, vec3 normal, vec3 lightDirection) {
    float diff = max(dot(normal, lightDirection), 0.0);
    return diff * lightColor;
}

vec3 specular(vec3 lightColor, vec3 fragPos, vec3 lightDirection, vec3 normal, float shininess, float specularStrength) {
    vec3 viewDirection = normalize(viewPosition - fragPos);
    vec3 reflectDirection = reflect(-lightDirection, normal);
    float spec = pow(max(dot(viewDirection, reflectDirection), 0.0), shininess);
    return specularStrength * spec * lightColor;
}

vec3 calculateDirectionLight(vec3 albedo, vec3 normal, vec3 fragPos, float shininess, float specularStrength) {
    vec3 lightDirection = normalize(directionLight.direction);

    vec3 ambientComp = ambient(directionLight.ambient, directionLight.intensity);
    vec3 diffuseComp = diffuse(directionLight.color, normal, lightDirection);
    vec3 specularComp = specular(directionLight.color, fragPos, lightDirection, normal, shininess, specularStrength);

    return (ambientComp + diffuseComp + specularComp) * albedo * directionLight.intensity;
}

// --- Main ---
void main(void) {
    ivec2 computeCoord = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    vec3 finalColor = vec3(0);
    vec3 albedo = vec3(0);
    vec3 position = vec3(0);
    vec4 normal = vec4(0);
    vec4 specular_emission_diffuse_ssao_bloom = vec4(0);

    if (imageLoad(sampleCoverageMask, computeCoord).r == 1.0) {
        // Multisampled case
        for (int i = 0; i < numSamples; i++) {
            albedo = imageLoad(albedoSampler, computeCoord, i).rgb;
            normal = imageLoad(normalSampler, computeCoord, i).rgba;

            if (normal.a != 0) {
                position = imageLoad(worldPositionSampler, computeCoord, i).rgb;
                specular_emission_diffuse_ssao_bloom = imageLoad(specular_emission_diffuse_ssao_bloom_Sampler, computeCoord, i).rgba;

                float shininess = specular_emission_diffuse_ssao_bloom.r;
                float specularStrength = specular_emission_diffuse_ssao_bloom.g;
                finalColor += calculateDirectionLight(albedo, normal.rgb, position, shininess, specularStrength);
            } else {
                finalColor += albedo;
            }
        }
        finalColor /= numSamples;
    } else {
        // Non-multisampled case
        albedo = imageLoad(albedoSampler, computeCoord, 0).rgb;
        normal = imageLoad(normalSampler, computeCoord, 0).rgba;

        if (normal.a != 0) {
            position = imageLoad(worldPositionSampler, computeCoord, 0).rgb;
            specular_emission_diffuse_ssao_bloom = imageLoad(specular_emission_diffuse_ssao_bloom_Sampler, computeCoord, 0).rgba;

            float shininess = specular_emission_diffuse_ssao_bloom.r;
            float specularStrength = specular_emission_diffuse_ssao_bloom.g;
            finalColor = calculateDirectionLight(albedo, normal.rgb, position, shininess, specularStrength);
        } else {
            finalColor = albedo;
        }
    }

    imageStore(defferedSceneImage, computeCoord, vec4(finalColor, 1.0));
}
